# ===== LLM =====
# Provider: anthropic | openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
LLM_MODEL=claude-opus-4-8

# ===== Apify (scraper-service) =====
APIFY_API_TOKEN=your_apify_token_here

# ===== Auth =====
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ===== Postgres =====
POSTGRES_USER=career
POSTGRES_PASSWORD=career_pass
POSTGRES_DB=career_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432


# ===== RabbitMQ =====
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ===== Service URLs (nội bộ docker network) =====
AUTH_SERVICE_URL=http://auth-service:8000
PROFILE_SERVICE_URL=http://profile-service:8000
SCRAPER_SERVICE_URL=http://scraper-service:8000
CV_SERVICE_URL=http://cv-agent-service:8000
ATS_SERVICE_URL=http://ats-agent-service:8000
PDF_SERVICE_URL=http://pdf-service:8000

ATS_PASS_THRESHOLD=70
ATS_MAX_ATTEMPTS=3
