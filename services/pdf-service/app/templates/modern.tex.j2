\documentclass[10pt,a4paper]{article}

\usepackage[margin=0cm]{geometry}
\usepackage{xcolor}
\usepackage[hidelinks]{hyperref}
\usepackage{enumitem}
\usepackage{paracol}
\usepackage{microtype}

\definecolor{Charcoal}{HTML}{252525}
\definecolor{Ink}{HTML}{282828}
\definecolor{Muted}{HTML}{6B6B6B}
\definecolor{Rule}{HTML}{D9D9D9}

\renewcommand{\familydefault}{\sfdefault}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\setlength{\fboxsep}{0pt}
\pagestyle{empty}
\emergencystretch=1em

\newcommand{\sidebarheading}[1]{%
  \vspace{13pt}{\color{white}\bfseries\fontsize{10}{12}\selectfont #1}\par
  \vspace{4pt}\textcolor{white!35}{\rule{\linewidth}{0.45pt}}\vspace{6pt}}

\newcommand{\cvsection}[1]{%
  \vspace{11pt}{\color{Ink}\bfseries\fontsize{12}{14}\selectfont #1}\par
  \vspace{3pt}\textcolor{Rule}{\rule{\dimexpr\linewidth-16pt\relax}{0.55pt}}\vspace{5pt}}

\newcommand{\cventry}[4]{%
  {\bfseries\color{Ink}#1}\hfill {\color{Muted}\small #2}\par
  {\itshape\color{Muted}\small #3}\par
  \vspace{2pt}{\small #4}\par\vspace{5pt}}

\setlist[itemize]{leftmargin=1.2em,itemsep=1.5pt,topsep=2pt,parsep=0pt,partopsep=0pt}

% Bề ngang cột nhãn bảng kỹ năng — đo từ nhãn dài nhất (xem mục SKILLS).
\newlength{\cvskilllabel}
\newlength{\cvskilltmp}

\begin{document}
\color{Ink}

\columnratio{0.34}
\setlength{\columnsep}{0.04\paperwidth}
\begin{paracol}{2}

% ---------- LEFT SIDEBAR: contact + education ----------
\switchcolumn[0]
\raggedright\noindent\colorbox{Charcoal}{%
\begin{minipage}[t][\dimexpr\paperheight-5pt\relax][t]{\linewidth}
\vspace{20pt}\hspace{18pt}\begin{minipage}{\dimexpr\linewidth-36pt\relax}

\BLOCK{ if hdr.full_name }{\color{white}\bfseries\fontsize{18}{20}\selectfont \raggedright \VAR{hdr.full_name | tex}}\par\BLOCK{ endif }%
\BLOCK{ if hdr.headline }\vspace{4pt}{\color{white!68}\fontsize{10}{12}\selectfont \VAR{hdr.headline | tex}}\par\BLOCK{ endif }

\BLOCK{ if hdr.email or hdr.phone or hdr.location or hdr.github_url or hdr.linkedin_url }
\sidebarheading{CONTACT}
\BLOCK{ if hdr.email }{\color{white!88}\small \textbf{Email}\\ \VAR{hdr.email | tex}}\par\vspace{6pt}\BLOCK{ endif }%
\BLOCK{ if hdr.phone }{\color{white!88}\small \textbf{Phone}\\ \VAR{hdr.phone | tex}}\par\vspace{6pt}\BLOCK{ endif }%
\BLOCK{ if hdr.location }{\color{white!88}\small \textbf{Location}\\ \VAR{hdr.location | tex}}\par\vspace{6pt}\BLOCK{ endif }%
\BLOCK{ if hdr.github_url }{\small\href{\VAR{hdr.github_url | texurl}}{\color{white!88}\textbf{\VAR{hdr.github_url | linklabel}}}}\par\vspace{6pt}\BLOCK{ endif }%
\BLOCK{ if hdr.linkedin_url }{\small\href{\VAR{hdr.linkedin_url | texurl}}{\color{white!88}\textbf{LinkedIn}}}\par\vspace{6pt}\BLOCK{ endif }
\BLOCK{ endif }

\BLOCK{ if cv.education }
\sidebarheading{EDUCATION}
\BLOCK{ for ed in cv.education }
{\color{white!88}\small \textbf{\VAR{ed.school | tex}}}\par
\BLOCK{ if ed.degree or ed.field_of_study }{\color{white!68}\small \BLOCK{ if ed.degree }\VAR{ed.degree | tex}\BLOCK{ endif }\BLOCK{ if ed.field_of_study }\BLOCK{ if ed.degree } --- \BLOCK{ endif }\VAR{ed.field_of_study | tex}\BLOCK{ endif }}\par\BLOCK{ endif }
\BLOCK{ if ed.start_date | monthyear }{\color{white!55}\small \VAR{ed.start_date | monthyear | tex} -- \VAR{((ed.end_date | monthyear) or "Present") | tex}}\par\BLOCK{ endif }
\BLOCK{ if ed.description | bullets }{\color{white!68}\small\begin{itemize}[leftmargin=*,nosep]\BLOCK{ for line in ed.description | bullets }\item \VAR{line | tex}
\BLOCK{ endfor }\end{itemize}}\par\BLOCK{ endif }
\vspace{6pt}
\BLOCK{ endfor }
\BLOCK{ endif }

\end{minipage}\end{minipage}}

% ---------- RIGHT COLUMN: summary + skills + experience ----------
\switchcolumn[1]
\vspace*{24pt}
\rightskip=16pt

\BLOCK{ if cv.summary }
\cvsection{SUMMARY}
{\small \VAR{cv.summary | tex}}\par
\BLOCK{ endif }

\BLOCK{ if cv | skillgroups }
\cvsection{SKILLS}
% \rightskip=16pt ở trên chỉ thụt lề ĐOẠN VĂN; tabular là box nên phớt lờ nó
% và sẽ lấn ra sát mép giấy. Bọc minipage để phần lề chừa đó thành thật, đồng
% thời \linewidth trong preamble bảng không còn phụ thuộc bookkeeping của
% paracol. Cột nhãn đo theo nhãn dài nhất (xem chú thích ở classic.tex.j2);
% trần ở đây chặt hơn (0.38) vì cột phải paracol chỉ rộng ~0.62 trang, nhãn
% quá khổ sẽ không còn chỗ cho danh sách kỹ năng.
\noindent\begin{minipage}{\dimexpr\linewidth-16pt\relax}
{\small
\begingroup
\setlength{\cvskilllabel}{0pt}
\BLOCK{ for g in cv | skillgroups }\settowidth{\cvskilltmp}{\small\textbf{\VAR{g.category | tex}}}\ifdim\cvskilltmp>\cvskilllabel\setlength{\cvskilllabel}{\cvskilltmp}\fi
\BLOCK{ endfor }\ifdim\cvskilllabel>0.38\linewidth\setlength{\cvskilllabel}{0.38\linewidth}\fi
\setlength{\tabcolsep}{0pt}
\renewcommand{\arraystretch}{1.25}
\begin{tabular}{@{}p{\cvskilllabel}@{\hspace{5pt}}l@{\hspace{5pt}}p{\dimexpr\linewidth-\cvskilllabel-14pt\relax}@{}}
\BLOCK{ for g in cv | skillgroups }\raggedright\textbf{\VAR{g.category | tex}} & : & \VAR{ g.skills | map("tex") | join(", ") } \\
\BLOCK{ endfor }\end{tabular}
\endgroup}
\end{minipage}\par
\BLOCK{ endif }

\BLOCK{ if cv.experience }
\cvsection{WORK EXPERIENCE}
\BLOCK{ for e in cv.experience }
\cventry{\VAR{e.title | tex}}{\BLOCK{ if e.start_date | monthyear }\VAR{e.start_date | monthyear | tex} -- \VAR{((e.end_date | monthyear) or "Present") | tex}\BLOCK{ endif }}{\VAR{e.organization | tex}}{\BLOCK{ if e.description | bullets }\begin{itemize}[leftmargin=*,nosep]\BLOCK{ for line in e.description | bullets }\item \VAR{line | tex}
\BLOCK{ endfor }\end{itemize}\BLOCK{ endif }}
\BLOCK{ endfor }
\BLOCK{ endif }

\BLOCK{ if cv.certifications }
\cvsection{CERTIFICATIONS}
\BLOCK{ for cert in cv.certifications }
\cventry{\VAR{cert.title | tex}}{\VAR{cert.obtain_date | monthyear | tex}}{}{}
\BLOCK{ endfor }
\BLOCK{ endif }

\end{paracol}
\end{document}
