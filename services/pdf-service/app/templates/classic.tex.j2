\documentclass[a4paper,10pt]{article}
\usepackage[utf8]{inputenc}
\usepackage[margin=0.75in]{geometry}
\usepackage[hidelinks]{hyperref}
\usepackage{enumitem}
\usepackage{titlesec}

\pagestyle{empty}
\raggedbottom
\raggedright

% Section heading: chữ hoa + gạch ngang bên dưới (classic style)
\titleformat{\section}
  {\vspace{10pt}\large\bfseries\uppercase}
  {}{0em}{}
  [\vspace{2pt}\hrule height 0.8pt \vspace{8pt}]

\setlist[itemize]{leftmargin=1.2em, itemsep=2pt, parsep=0pt, topsep=2pt}

% Bề ngang cột nhãn của bảng kỹ năng — đo từ nhãn DÀI NHẤT ngay trước khi
% dựng bảng (xem mục SKILLS). Cột cố định sẵn sẽ vừa thừa chỗ với nhãn ngắn
% vừa ngắt dòng với nhãn dài.
\newlength{\cvskilllabel}
\newlength{\cvskilltmp}

\begin{document}

% ---------- HEADER ----------
\begin{center}
\BLOCK{ if hdr.full_name }{\Huge \textbf{\VAR{hdr.full_name | tex}}}\\[4pt]\BLOCK{ endif }%
\BLOCK{ if hdr.headline }{\large \VAR{hdr.headline | tex}}\\[8pt]\BLOCK{ endif }%
\small
% Contact trên MỘT dòng, ngăn bằng dấu chấm giữa. `ns.any` theo dõi đã in mục
% nào chưa, để dấu ngăn chỉ xuất hiện GIỮA hai mục — thiếu email hay phone thì
% không còn dấu thừa ở đầu/cuối dòng.
\BLOCK{ set ns = namespace(any=False) }%
\BLOCK{ if hdr.location }\VAR{hdr.location | tex}\BLOCK{ set ns.any = True }\BLOCK{ endif }%
\BLOCK{ if hdr.phone }\BLOCK{ if ns.any }\ \textperiodcentered\ \BLOCK{ endif }\VAR{hdr.phone | tex}\BLOCK{ set ns.any = True }\BLOCK{ endif }%
\BLOCK{ if hdr.email }\BLOCK{ if ns.any }\ \textperiodcentered\ \BLOCK{ endif }\VAR{hdr.email | tex}\BLOCK{ set ns.any = True }\BLOCK{ endif }%
\BLOCK{ if hdr.github_url }\BLOCK{ if ns.any }\ \textperiodcentered\ \BLOCK{ endif }\href{\VAR{hdr.github_url | texurl}}{\textbf{\VAR{hdr.github_url | linklabel}}}\BLOCK{ set ns.any = True }\BLOCK{ endif }%
\BLOCK{ if hdr.linkedin_url }\BLOCK{ if ns.any }\ \textperiodcentered\ \BLOCK{ endif }\href{\VAR{hdr.linkedin_url | texurl}}{\textbf{LinkedIn}}\BLOCK{ endif }%
\end{center}
\vspace{-2pt}

% ---------- SUMMARY ----------
\section{Objective}
\VAR{cv.summary | tex}

% ---------- EDUCATION ----------
\BLOCK{ if cv.education }
\section{Education}
\BLOCK{ for ed in cv.education }
\textbf{\VAR{ed.school | tex}} \hfill \BLOCK{ if ed.start_date | monthyear }\VAR{ed.start_date | monthyear | tex} -- \VAR{((ed.end_date | monthyear) or "Present") | tex}\BLOCK{ endif }\par
\BLOCK{ if ed.degree }\VAR{ed.degree | tex}\BLOCK{ if ed.field_of_study } --- \VAR{ed.field_of_study | tex}\BLOCK{ endif }\par\BLOCK{ endif }%
\BLOCK{ if ed.description | bullets }\begin{itemize}[leftmargin=*,nosep,topsep=2pt]\BLOCK{ for line in ed.description | bullets }\item \VAR{line | tex}
\BLOCK{ endfor }\end{itemize}\BLOCK{ endif }
\vspace{6pt}
\BLOCK{ endfor }
\BLOCK{ endif }

% ---------- SKILLS ----------
% Bảng 2 cột căn thẳng: nhãn nhóm | dấu hai chấm | kỹ năng.
% Cột nhãn ĐO theo nhãn dài nhất (\settowidth) thay vì cố định: nhãn ngắn
% không để thừa chỗ, nhãn dài như "Containers & Orchestration" không bị ngắt
% dòng. Trần 0.42\linewidth chặn nhãn quá khổ nuốt hết cột kỹ năng; nhãn vượt
% trần mới xuống dòng, và \raggedright giữ nó không bị giãn chữ/gạch nối.
% Cell p{} căn theo dòng ĐẦU, nên ':' thẳng hàng với dòng đầu của danh sách
% kỹ năng dài, còn dòng wrap thụt vào dưới cột kỹ năng.
\BLOCK{ if cv | skillgroups }
\section{Skills}
\begingroup
\setlength{\cvskilllabel}{0pt}
\BLOCK{ for g in cv | skillgroups }\settowidth{\cvskilltmp}{\textbf{\VAR{g.category | tex}}}\ifdim\cvskilltmp>\cvskilllabel\setlength{\cvskilllabel}{\cvskilltmp}\fi
\BLOCK{ endfor }\ifdim\cvskilllabel>0.42\linewidth\setlength{\cvskilllabel}{0.42\linewidth}\fi
\setlength{\tabcolsep}{0pt}
\renewcommand{\arraystretch}{1.15}
\begin{tabular}{@{}p{\cvskilllabel}@{\hspace{6pt}}l@{\hspace{6pt}}p{\dimexpr\linewidth-\cvskilllabel-16pt\relax}@{}}
\BLOCK{ for g in cv | skillgroups }\raggedright\textbf{\VAR{g.category | tex}} & : & \VAR{ g.skills | map("tex") | join(", ") } \\
\BLOCK{ endfor }\end{tabular}
\endgroup
\BLOCK{ endif }

% ---------- WORK EXPERIENCE ----------
\BLOCK{ if cv.experience }
\section{Work Experience}
\BLOCK{ for e in cv.experience }
\textbf{\VAR{e.organization | tex}} \hfill \BLOCK{ if e.start_date | monthyear }\VAR{e.start_date | monthyear | tex} -- \VAR{((e.end_date | monthyear) or "Present") | tex}\BLOCK{ endif }\par
\textbf{\VAR{e.title | tex}}\par
\BLOCK{ if e.description | bullets }\begin{itemize}[leftmargin=*,nosep,topsep=2pt]\BLOCK{ for line in e.description | bullets }\item \VAR{line | tex}
\BLOCK{ endfor }\end{itemize}\BLOCK{ endif }
\vspace{8pt}
\BLOCK{ endfor }
\BLOCK{ endif }

% ---------- CERTIFICATIONS ----------
\BLOCK{ if cv.certifications }
\section{Certifications}
\BLOCK{ for cert in cv.certifications }
\textbf{\VAR{cert.title | tex}} \hfill \VAR{cert.obtain_date | monthyear | tex}\par
\vspace{4pt}
\BLOCK{ endfor }
\BLOCK{ endif }


\end{document}
