\documentclass[11pt,a4paper]{article}

\usepackage[margin=2.2cm]{geometry}
\usepackage[hidelinks]{hyperref}
\usepackage{enumitem}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\pagestyle{empty}

\newcommand{\cvsection}[1]{%
  \vspace{14pt}{\large\bfseries\scshape #1}\par
  \vspace{2pt}\hrule height 0.5pt \vspace{6pt}}

\newcommand{\academicentry}[3]{%
  \textbf{#1} \hfill #2\par
  \textit{#3}\par\vspace{4pt}}

\setlist[itemize]{leftmargin=1.5em,itemsep=2pt,topsep=2pt,parsep=0pt}

% Bề ngang cột nhãn bảng kỹ năng — đo từ nhãn dài nhất (xem mục SKILLS).
\newlength{\cvskilllabel}
\newlength{\cvskilltmp}

\begin{document}

% ---------- HEADER ----------
\begin{center}
\BLOCK{ if hdr.full_name }{\Large\bfseries \VAR{hdr.full_name | tex}}\\[4pt]\BLOCK{ endif }%
\BLOCK{ if hdr.headline }\VAR{hdr.headline | tex}\\\BLOCK{ endif }%
% Contact trên MỘT dòng, ngăn bằng dấu chấm giữa (xem chú thích ở classic).
\BLOCK{ set ns = namespace(any=False) }%
\BLOCK{ if hdr.location }\VAR{hdr.location | tex}\BLOCK{ set ns.any = True }\BLOCK{ endif }%
\BLOCK{ if hdr.phone }\BLOCK{ if ns.any }\ \textperiodcentered\ \BLOCK{ endif }\VAR{hdr.phone | tex}\BLOCK{ set ns.any = True }\BLOCK{ endif }%
\BLOCK{ if hdr.email }\BLOCK{ if ns.any }\ \textperiodcentered\ \BLOCK{ endif }\VAR{hdr.email | tex}\BLOCK{ set ns.any = True }\BLOCK{ endif }%
\BLOCK{ if hdr.github_url }\BLOCK{ if ns.any }\ \textperiodcentered\ \BLOCK{ endif }\href{\VAR{hdr.github_url | texurl}}{\VAR{hdr.github_url | linklabel}}\BLOCK{ set ns.any = True }\BLOCK{ endif }%
\BLOCK{ if hdr.linkedin_url }\BLOCK{ if ns.any }\ \textperiodcentered\ \BLOCK{ endif }\href{\VAR{hdr.linkedin_url | texurl}}{LinkedIn}\BLOCK{ endif }%
\end{center}
\vspace{-4pt}

% ---------- SUMMARY ----------
\cvsection{Summary}
\VAR{cv.summary | tex}

% ---------- EDUCATION ----------
\BLOCK{ if cv.education }
\cvsection{Education}
\BLOCK{ for ed in cv.education }
\academicentry{\VAR{ed.degree | tex}\BLOCK{ if ed.field_of_study } in \VAR{ed.field_of_study | tex}\BLOCK{ endif }}{\BLOCK{ if ed.start_date | monthyear }\VAR{ed.start_date | monthyear | tex} -- \VAR{((ed.end_date | monthyear) or "Present") | tex}\BLOCK{ endif }}{\VAR{ed.school | tex}}
\BLOCK{ if ed.description | bullets }\begin{itemize}[leftmargin=*,nosep,topsep=2pt]\BLOCK{ for line in ed.description | bullets }\item \VAR{line | tex}
\BLOCK{ endfor }\end{itemize}\BLOCK{ endif }
\BLOCK{ endfor }
\BLOCK{ endif }

% ---------- SKILLS ----------
% Bảng 2 cột, cột nhãn đo theo nhãn dài nhất (xem chú thích ở classic.tex.j2).
\BLOCK{ if cv | skillgroups }
\cvsection{Technical Skills \& Competencies}
\begingroup
\setlength{\cvskilllabel}{0pt}
\BLOCK{ for g in cv | skillgroups }\settowidth{\cvskilltmp}{\textbf{\VAR{g.category | tex}}}\ifdim\cvskilltmp>\cvskilllabel\setlength{\cvskilllabel}{\cvskilltmp}\fi
\BLOCK{ endfor }\ifdim\cvskilllabel>0.42\linewidth\setlength{\cvskilllabel}{0.42\linewidth}\fi
\setlength{\tabcolsep}{0pt}
\renewcommand{\arraystretch}{1.2}
\begin{tabular}{@{}p{\cvskilllabel}@{\hspace{6pt}}l@{\hspace{6pt}}p{\dimexpr\linewidth-\cvskilllabel-16pt\relax}@{}}
\BLOCK{ for g in cv | skillgroups }\raggedright\textbf{\VAR{g.category | tex}} & : & \VAR{ g.skills | map("tex") | join(", ") } \\
\BLOCK{ endfor }\end{tabular}
\endgroup
\BLOCK{ endif }

% ---------- EXPERIENCE ----------
\BLOCK{ if cv.experience }
\cvsection{Professional Appointments}
\BLOCK{ for e in cv.experience }
\academicentry{\VAR{e.title | tex}}{\BLOCK{ if e.start_date | monthyear }\VAR{e.start_date | monthyear | tex} -- \VAR{((e.end_date | monthyear) or "Present") | tex}\BLOCK{ endif }}{\VAR{e.organization | tex}}
\BLOCK{ if e.description | bullets }\begin{itemize}[leftmargin=*,nosep,topsep=2pt]\BLOCK{ for line in e.description | bullets }\item \VAR{line | tex}
\BLOCK{ endfor }\end{itemize}\BLOCK{ endif }
\BLOCK{ endfor }
\BLOCK{ endif }

% ---------- CERTIFICATIONS ----------
\BLOCK{ if cv.certifications }
\cvsection{Certifications}
\BLOCK{ for cert in cv.certifications }
\academicentry{\VAR{cert.title | tex}}{\VAR{cert.obtain_date | monthyear | tex}}{}
\BLOCK{ endfor }
\BLOCK{ endif }


\end{document}
